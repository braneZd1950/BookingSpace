# Poslužitelj
NODE_ENV=development
PORT=4000

# MongoDB Atlas (ili lokalni MongoDB)
MONGO_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Domene iz specifikacije
BASE_DOMAIN=bookingspace.hr
PLATFORM_ORIGIN=https://bookingspace.hr
APP_ORIGIN=https://app.bookingspace.hr
API_ORIGIN=https://api.bookingspace.hr

# Cloudinary (slike tenanta: logo, hero, galerija)
# https://console.cloudinary.com → Settings → API Keys
# Preferiraj upis u server/.env (ima prednost pri učitavanju)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend
VITE_API_URL=https://api.bookingspace.hr/api
# Početna — pravi partneri (build-time). Prazno = „Uskoro s nama” placeholdere.
# Primjer: PowerFit Zadar|/s/powerfit, Studio Ravnoteža|/s/ravnoteza
VITE_HOME_PARTNERS=

# Platform analitika (zarezom više e-pošta) — vidi /analitika
ADMIN_EMAILS=

# Email — Brevo SMTP (pozivnica članu s automatskom lozinkom)
# Brevo → SMTP & API → SMTP: Login = SMTP_USER, SMTP key = SMTP_PASS
# EMAIL_FROM mora biti verificirani pošiljatelj u Brevo računu.
# Provjera: cd server && npm run mail:check
# Kodove upiši u server/.env (ili root .env) — ne commitaj taj fajl.
CLIENT_ORIGIN=http://localhost:5173
EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Online plaćanje (nije dio MVP-a, još se ne koristi)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
