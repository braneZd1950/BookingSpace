# Predložak za LOKALNI razvoj. Kopiraj u `.env` u rootu repoa.
# Server i Vite čitaju ovaj jedan fajl. Vite u browser šalje samo VITE_*.
#
# Produkcija / Render: koristi `.env.production.example` + docs/20-production-launch.md
# (ne miješaj production tajne u lokalni `.env`).

# --- Lokalni razvoj (demo seed, mock Otkrij, PDF oznaka TEST) ---
NODE_ENV=development
PORT=4001

# Lokalno /api (Vite proxy). Na Renderu puni URL, npr. https://bookingspaceapp.onrender.com/api
VITE_API_URL=/api

# Opcionalno: development | staging | production (override PDF / načina rada)
# VITE_APP_MODE=development
# Cijela web app → stranica održavanja (true | false)
# VITE_MAINTENANCE=true
# Google Sign-In (Web client ID from Google Cloud Console)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=web-id,ios-id,android-id
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
VITE_SHOW_HOME_PARTNERS=false
VITE_HOME_PARTNERS=

# Gumb „Preuzmite aplikaciju” — instalacija na uređaj (PWA) ili APK sideload.
# VITE_MOBILE_APK_URL=https://…/anyminutes.apk


MONGO_URI=
JWT_SECRET=
# Prefer shorter lifetimes in production (12h–24h). Logout / password change revoke older tokens.
JWT_EXPIRES_IN=24h

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN_MOBILE=http://localhost:5174
CLIENT_ORIGINS=


# Opcionalni bootstrap: e-pošte s pristupom platformi bez role ADMIN.
# U produkciji ostavite prazno i ADMIN_EMAIL_BOOTSTRAP=false; koristite DB role ADMIN.
# Super admin: node server/scripts/promote-super-admin.js email@…
ADMIN_EMAILS=
# true | false | unset (unset = dozvoljeno samo izvan production)
# ADMIN_EMAIL_BOOTSTRAP=false


EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@anyminutes.hr

# Sentry (opcionalno lokalno; na Renderu obavezno za error tracking)
# SENTRY_DSN=https://…@….ingest.us.sentry.io/…
# VITE_SENTRY_DSN=https://…@….ingest.us.sentry.io/…

# --- Produkcija ---
# Ne konfiguriraj ovdje. Vidi:
#   .env.production.example
#   docs/20-production-launch.md
#   docs/17-render-deploy.md
#   npm run check:prod -- --file .env.production --force

