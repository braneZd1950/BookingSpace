# Predložak. Kopiraj u .env u rootu repoa i upiši vrijednosti.
# Server i Vite čitaju ovaj jedan fajl. Vite u browser šalje samo VITE_*.
# Na Renderu fajl se ne koristi — iste ključeve upiši u Environment (vidi docs/17-render-deploy.md).

# --- Lokalni razvoj (demo seed, mock Otkrij, PDF oznaka TEST) ---
NODE_ENV=development
PORT=4001

# Lokalno /api (Vite proxy). Na Renderu puni URL, npr. https://bookingspaceapp.onrender.com/api
VITE_API_URL=/api
# Opcionalno: development | staging | production (override PDF / načina rada)
# VITE_APP_MODE=development
VITE_SHOW_HOME_PARTNERS=false
VITE_HOME_PARTNERS=

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN_MOBILE=http://localhost:5174
CLIENT_ORIGINS=

# Opcionalni bootstrap: e-pošte s pristupom platformi bez role ADMIN.
# Super admin (role: ADMIN) dodajte ručno: node server/scripts/promote-super-admin.js email@…
ADMIN_EMAILS=

EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@anyminutes.hr

# --- Render / produkcija (kratko) ---
# NODE_ENV=production
# CLIENT_ORIGIN=https://VAS-SERVIS.onrender.com
# VITE_API_URL=https://VAS-SERVIS.onrender.com/api
# VITE_APP_MODE=production
# SERVE_CLIENT=true
# Ne pokretati: npm --prefix server run seed:demo
# Super admin: node server/scripts/promote-super-admin.js admin@vasa-domena.hr
# PDF fontovi: client/public/fonts/*.ttf (ulaze u build)
# Opcionalno odvojeni tajni ključ za digitalni pečat izvoza (inače JWT_SECRET):
# EXPORT_SEAL_SECRET=
