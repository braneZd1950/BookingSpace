# =============================================================================
# Produkciski predložak (Render / VPS) — NE koristiti na localhostu za `npm run dev`.
# Lokalno i dalje: kopirajte `.env.example` → `.env` (NODE_ENV=development).
#
# Na Renderu ove ključeve upišite u Environment (fajl se ne deploya).
# Prije go-live: node scripts/check-production-env.js --file .env.production --force
# =============================================================================

NODE_ENV=production
PORT=4001
SERVE_CLIENT=true

# MongoDB Atlas (produkcijski cluster, ne lokalni seed)
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/anyminutes?retryWrites=true&w=majority

# Generirajte: npm --prefix server run generate:jwt-secret
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Obavezno odvojeno od JWT_SECRET
EXPORT_SEAL_SECRET=

# Javni HTTPS origin SPA-a (isti host ako Opcija A na Renderu)
CLIENT_ORIGIN=https://VAS-SERVIS.onrender.com
CLIENT_ORIGINS=
CLIENT_ORIGIN_MOBILE=

# Mora biti postavljen PRIJE `npm run build:render` / client builda
VITE_API_URL=https://VAS-SERVIS.onrender.com/api
VITE_APP_MODE=production
VITE_SHOW_HOME_PARTNERS=false
# Direktno preuzimanje APK-a s weba (ili CDN). Bez Google Play za sada.
# VITE_APP_ANDROID_URL=https://VAS-SERVIS.onrender.com/downloads/anyminutes.apk

# Platform admin samo preko DB role (promote-super-admin.js) — bootstrap isključen
ADMIN_EMAILS=
ADMIN_EMAIL_BOOTSTRAP=false

# Google Sign-In (Web client ID; optional comma list for iOS/Android)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=
# VITE_GOOGLE_CLIENT_ID=

# Mail (obavezno za pozivnice / reset lozinke / potvrde termina)
EMAIL_FROM=anyminutes <noreply@vasa-domena.hr>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mediji (preporučeno u produkciji)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (opcionalno, ali potrebno za push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@vasa-domena.hr

# Native Expo (EAS secrets / mobile/.env.production — ne commitati)
# EXPO_PUBLIC_API_URL=https://VAS-SERVIS.onrender.com/api
