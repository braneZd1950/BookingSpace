# =============================================================================
# Produkciski predložak (Render) — NE koristiti na localhostu za `npm run dev`.
# Lokalno: `.env.example` → `.env` (NODE_ENV=development).
#
# Preporuka: Opcija A = JEDAN Web Service (SPA + API).
# Sve ključeve stavi na taj servis. VITE_* se peče u buildu — nakon izmjene
# VITE_* napravi Clear build cache & deploy.
#
# Prije go-live: node scripts/check-production-env.js --file .env.production --force
# =============================================================================

NODE_ENV=production
PORT=4001
SERVE_CLIENT=true
ADMIN_EMAIL_BOOTSTRAP=false
ADMIN_EMAILS=

# MongoDB Atlas (produkcijski cluster — ne lokalni seed /test)
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/anyminutes?retryWrites=true&w=majority

# Generirajte: npm --prefix server run generate:jwt-secret
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Obavezno odvojeno od JWT_SECRET
EXPORT_SEAL_SECRET=

# Javni HTTPS origin SPA-a (isti host ako Opcija A)
CLIENT_ORIGIN=https://bookingspaceapp.onrender.com
CLIENT_ORIGINS=

# Peče se u client buildu — puni HTTPS API prefix
VITE_API_URL=https://bookingspaceapp.onrender.com/api
VITE_APP_MODE=production
VITE_SHOW_HOME_PARTNERS=false

# Mail (nodemailer SMTP — kod NE čita EMAIL_API_KEY)
EMAIL_FROM=anyminutes <noreply@vasa-domena.hr>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mediji (preporučeno)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@vasa-domena.hr

# Google Sign-In (opcionalno) — server verifikacija ID tokena
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Sentry — dva odvojena projecta (API vs SPA)
# SENTRY_DSN=          # Node / API project DSN
# VITE_SENTRY_DSN=     # React / browser project DSN (bake u build)

# -----------------------------------------------------------------------------
# NE stavljati / ukloniti s Rendera (kod ih ne koristi ili su uklonjeni):
#   ANDROID_APP_*          (native app uklonjena)
#   EMAIL_API_KEY          (koristi SMTP_*)
#   GOOGLE_CLIENT_SECRET   (web GIS koristi client ID, ne secret)
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET  (Stripe nije u pilotu)
#   API_ORIGIN / APP_ORIGIN / BASE_DOMAIN / CLIENT_URL / PLATFORM_ORIGIN
# -----------------------------------------------------------------------------
