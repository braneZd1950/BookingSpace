# Native app talks to the same API as the web SPA.
#
# Local / Expo Go (phone on same Wi‑Fi): use your machine LAN IP, not a public URL.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4001/api
EXPO_PUBLIC_APP_NAME=anyminutes
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:5173
# Whole-app maintenance screen (mirror of web VITE_MAINTENANCE)
# EXPO_PUBLIC_MAINTENANCE=true
# Google Sign-In (same Web client ID as VITE_GOOGLE_CLIENT_ID; add iOS/Android IDs for store builds)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
#
# Production / EAS store builds (set as EAS secret — never ship LAN/localhost):
# EXPO_PUBLIC_API_URL=https://VAS-SERVIS.onrender.com/api
# EXPO_PUBLIC_WEB_URL=https://VAS-SERVIS.onrender.com
# EXPO_PUBLIC_APP_ENV=production
