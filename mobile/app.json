{
  "expo": {
    "name": "anyminutes",
    "slug": "anyminutes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1614"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hr.anyminutes.app"
    },
    "android": {
      "package": "hr.anyminutes.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1614",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc5d8cb4-f6c1-4d4a-97b2-cb6feefd7776"
    },
    "extra": {
      "eas": {
        "projectId": "cc5d8cb4-f6c1-4d4a-97b2-cb6feefd7776"
      }
    }
  }
}
