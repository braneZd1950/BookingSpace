{
  "name": "bookingspace-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import ./src/instrument.js src/server.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node scripts/prefetch-mongo-memory.mjs && node --test --test-concurrency=1 --test-reporter=spec test/*.test.js",
    "prefetch:mongo": "node scripts/prefetch-mongo-memory.mjs",
    "test:limits": "node --test --test-timeout=180000 test/limits/*.test.js",
    "test:mobile-load": "node --test --test-timeout=300000 test/limits/mobile-load.test.js",
    "e2e:api": "node scripts/e2e-api.mjs",
    "seed:demo": "node scripts/seed-demo.js",
    "mail:check": "node scripts/check-mail.js",
    "generate:jwt-secret": "node src/utils/generateJwtSecret.js",
    "generate:jwt-secret:write": "node src/utils/generateJwtSecret.js --write",
    "generate:vapid": "node scripts/generate-vapid.js",
    "generate:vapid:write": "node scripts/generate-vapid.js --write"
  },
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
