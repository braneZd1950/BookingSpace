# Backend env — kopiraj u server/.env i upiši svoje vrijednosti.
# Učitava se uz root .env (server/.env ima prednost za iste ključeve).

NODE_ENV=development
# Lokalno 4001 (4000 često zauzme drugi projekt na istom PC-u)
PORT=4001
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Mobilni FE (client-mobile) — CORS
CLIENT_ORIGIN_MOBILE=http://localhost:5174
# Dodatni origin-i zarezom (Render frontend URL-ovi)
CLIENT_ORIGINS=

# Platform analitika — tvoja e-pošta (zarezom ako ih je više)
ADMIN_EMAILS=

# --- Web Push (VAPID) ---
# npm run generate:vapid:write
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@anyminutes.hr

# --- Brevo SMTP ---
# Dashboard: https://app.brevo.com/settings/keys/smtp
# SMTP_USER  = Login (e-pošta iz Brevo SMTP postavki)
# SMTP_PASS  = SMTP key (ne API key)
# EMAIL_FROM = verificirani sender, npr. BookingSpace <info@tvojadomena.hr>
EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Cloudinary (logo / hero / galerija studija) ---
# Dashboard: https://console.cloudinary.com → Settings → API Keys
# CLOUDINARY_CLOUD_NAME = Cloud name
# CLOUDINARY_API_KEY    = API Key
# CLOUDINARY_API_SECRET = API Secret
# Bez ovih vrijednosti upload ide lokalno u server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
