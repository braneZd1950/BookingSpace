# Backend env — kopiraj u server/.env i upiši svoje vrijednosti.
# Učitava se uz root .env (server/.env ima prednost za iste ključeve).

NODE_ENV=development
PORT=4000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Platform analitika — tvoja e-pošta (zarezom ako ih je više)
ADMIN_EMAILS=

# --- Brevo SMTP ---
# Dashboard: https://app.brevo.com/settings/keys/smtp
# SMTP_USER  = Login (e-pošta iz Brevo SMTP postavki)
# SMTP_PASS  = SMTP key (ne API key)
# EMAIL_FROM = verificirani sender, npr. BookingSpace <info@tvojadomena.hr>
EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
