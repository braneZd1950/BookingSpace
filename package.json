{
  "name": "bookingspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:mobile": "node scripts/dev-mobile.js",
    "start:native": "npm --prefix mobile start",
    "android": "npm --prefix mobile run android",
    "ios": "npm --prefix mobile run ios",
    "typecheck:native": "npm --prefix mobile run typecheck",
    "test": "npm run test:all",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:mobile": "npm --prefix mobile test",
    "test:all": "npm run test:server && npm run test:client && npm run test:mobile && npm run typecheck:native",
    "test:limits": "npm --prefix server run test:limits",
    "test:ci": "npm --prefix server run test:ci && npm run test:client && npm run test:mobile && npm run typecheck:native",
    "build:client": "npm --prefix client run build",
    "build:render": "npm ci --prefix server && npm ci --prefix client --include=dev && npm run build --prefix client",
    "build:prod": "npm run build:render",
    "check:prod": "node scripts/check-production-env.js",
    "launch:check": "npm run test:all && node scripts/check-production-env.js",
    "smoke": "node scripts/prod-smoke.js",
    "preview:client": "npm --prefix client exec -- vite preview --host 127.0.0.1 --port 4173"
  }
}
