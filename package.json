{
  "name": "bookingspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "npm run test:all",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:e2e": "npm --prefix client run test:e2e",
    "test:all": "npm run test:server && npm run test:client",
    "test:all:e2e": "npm run test:all && npm run test:e2e",
    "test:limits": "npm --prefix server run test:limits",
    "test:mobile": "npm --prefix mobile run test:ci",
    "test:mobile-load": "npm --prefix server run test:mobile-load",
    "test:mobile:all": "npm run test:mobile && npm run test:mobile-load",
    "test:ci": "npm --prefix server run test:ci && npm run test:client",
    "test:ci:e2e": "npm --prefix client run test:e2e",
    "build:client": "npm --prefix client run build",
    "build:render": "npm ci --prefix server && npm ci --prefix client --include=dev && npm run build --prefix client",
    "build:prod": "npm run build:render",
    "check:prod": "node scripts/check-production-env.js",
    "launch:check": "npm run test:all && node scripts/check-production-env.js",
    "smoke": "node scripts/prod-smoke.js",
    "preview:client": "npm --prefix client exec -- vite preview --host 127.0.0.1 --port 4173"
  }
}
